# === AI Provider Keys (disimpan di Cloudflare Pages Environment Variables) ===
# JANGAN pernah masukkan ini ke frontend.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (opsional, untuk model gratis cepat)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily untuk web search mode
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Supabase (diakses dari Worker) ===
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# === Cloudflare Workers AI (opsional) ===
# Binding AI otomatis tersedia jika diaktifkan di wrangler.toml
